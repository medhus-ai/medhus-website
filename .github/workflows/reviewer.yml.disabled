name: Reviewer

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, labeled]

jobs:
  review:
    if: github.event.pull_request.draft == false
    runs-on: [self-hosted, "project-medhus-website"]
    concurrency:
      group: pr-${{ github.event.pull_request.number }}
      cancel-in-progress: true
    permissions:
      pull-requests: write
      contents: read
      checks: write
      issues: write
    steps:
      - name: Checkout trusted base
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          fetch-depth: 1

      - name: Verify trusted author or label
        id: trust
        run: |
          if grep -qx "${{ github.event.pull_request.user.login }}" .github/slash-allowlist.txt; then
            echo "should_review=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          if gh pr view "${{ github.event.pull_request.number }}" --json labels --jq '.labels[].name' | grep -qx "trusted-for-agent-review"; then
            echo "should_review=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          gh pr comment "${{ github.event.pull_request.number }}" --body "Reviewer skipped: author is not allowlisted and PR is not labeled trusted-for-agent-review."
          echo "should_review=false" >> "$GITHUB_OUTPUT"
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Health check
        if: steps.trust.outputs.should_review == 'true'
        run: ./.github/scripts/auth-check.sh --runner reviewer

      - name: Budget check
        if: steps.trust.outputs.should_review == 'true'
        run: ./.github/scripts/budget-check.sh --pr "${{ github.event.pull_request.number }}" --workflow reviewer --runner reviewer
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Capture run start
        if: steps.trust.outputs.should_review == 'true'
        id: run_context
        run: echo "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$GITHUB_OUTPUT"

      - name: Fetch PR diff as data
        if: steps.trust.outputs.should_review == 'true'
        run: gh pr diff "${{ github.event.pull_request.number }}" > "$RUNNER_TEMP/pr-${{ github.event.pull_request.number }}.diff"
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Reviewer pass
        if: steps.trust.outputs.should_review == 'true'
        run: |
          cat > "$RUNNER_TEMP/reviewer-prompt.txt" <<PROMPT
          You are the Reviewer. You may only read repository files and GitHub metadata.
          Do not edit files, create commits, push branches, run project tests, install packages, or execute PR code.

          Read:
            - The PR diff at $RUNNER_TEMP/pr-${{ github.event.pull_request.number }}.diff
            - PR title, body, comments, and linked issue through gh
            - .agents/memory/conventions.md
            - .agents/memory/decisions/ if present

          Produce one GitHub PR review:
            - approve if clean
            - comment or request changes for specific, actionable concerns
            - soft-warn if the Test Envelope is incomplete on a low-risk change
            - request changes when new behavior lacks tests, risk is unclear, or conventions/ADRs are violated

          If security-sensitive concerns, suspected secret leakage, or irreversible change risks appear:
            - add label human-review-needed
            - do not approve

          Also create or update a check named reviewer-ai with success or failure.
          PROMPT
          ./.github/scripts/ai-run.sh --runner reviewer --prompt-file "$RUNNER_TEMP/reviewer-prompt.txt"
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Record successful review budget
        if: success() && steps.trust.outputs.should_review == 'true'
        run: ./.github/scripts/budget-record.sh --pr "${{ github.event.pull_request.number }}" --workflow reviewer --runner reviewer --result success --started-at "${{ steps.run_context.outputs.started_at }}"
        env:
          GITHUB_ACTOR: ${{ github.actor }}

      - name: Failure handling
        if: failure() && steps.trust.outputs.should_review == 'true'
        run: |
          gh pr comment "${{ github.event.pull_request.number }}" --body "Reviewer workflow failed; see Actions logs."
          gh pr edit "${{ github.event.pull_request.number }}" --add-label "blocked"
          ./.github/scripts/budget-record.sh --pr "${{ github.event.pull_request.number }}" --workflow reviewer --runner reviewer --result failure --started-at "${{ steps.run_context.outputs.started_at }}" || true
        env:
          GH_TOKEN: ${{ github.token }}
          GITHUB_ACTOR: ${{ github.actor }}
