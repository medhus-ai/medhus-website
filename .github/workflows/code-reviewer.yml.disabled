name: Code Reviewer

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, labeled]

jobs:
  review:
    if: github.event.pull_request.draft == false
    runs-on: [self-hosted, "project-medhus-website"]
    concurrency:
      group: pr-${{ github.event.pull_request.number }}
      cancel-in-progress: true
    permissions:
      pull-requests: write
      contents: read
      checks: write
      issues: write
    steps:
      - name: Checkout trusted base
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          fetch-depth: 1

      - name: Verify trusted author or label
        id: trust
        run: |
          if grep -qx "${{ github.event.pull_request.user.login }}" .github/slash-allowlist.txt; then
            echo "should_review=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          if node ./.github/scripts/github-api.js labels --pr "${{ github.event.pull_request.number }}" | grep -qx "trusted-for-agent-review"; then
            echo "should_review=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          node ./.github/scripts/github-api.js comment --pr "${{ github.event.pull_request.number }}" --body "Code Reviewer skipped: author is not allowlisted and PR is not labeled trusted-for-agent-review."
          echo "should_review=false" >> "$GITHUB_OUTPUT"
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Health check
        if: steps.trust.outputs.should_review == 'true'
        run: ./.github/scripts/auth-check.sh --runner code-reviewer

      - name: Budget check
        if: steps.trust.outputs.should_review == 'true'
        run: ./.github/scripts/budget-check.sh --pr "${{ github.event.pull_request.number }}" --workflow code-reviewer --runner code-reviewer
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Capture run start
        if: steps.trust.outputs.should_review == 'true'
        id: run_context
        run: echo "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$GITHUB_OUTPUT"

      - name: Fetch PR diff as data
        if: steps.trust.outputs.should_review == 'true'
        run: |
          node ./.github/scripts/github-api.js pr-diff --pr "${{ github.event.pull_request.number }}" > "$RUNNER_TEMP/pr-${{ github.event.pull_request.number }}.diff"
          node ./.github/scripts/github-api.js pr-json --pr "${{ github.event.pull_request.number }}" > "$RUNNER_TEMP/pr-${{ github.event.pull_request.number }}.json"
          node ./.github/scripts/github-api.js comments --pr "${{ github.event.pull_request.number }}" > "$RUNNER_TEMP/pr-${{ github.event.pull_request.number }}-comments.json"
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Code Reviewer pass
        if: steps.trust.outputs.should_review == 'true'
        run: |
          cat > "$RUNNER_TEMP/code-reviewer-prompt.txt" <<PROMPT
          You may only read repository files and GitHub metadata.
          Do not edit files, create commits, push branches, run project tests, install packages, or execute PR code.

          Read:
            - The PR diff at $RUNNER_TEMP/pr-${{ github.event.pull_request.number }}.diff
            - PR title/body at $RUNNER_TEMP/pr-${{ github.event.pull_request.number }}.json
            - PR comments at $RUNNER_TEMP/pr-${{ github.event.pull_request.number }}-comments.json
            - .agents/memory/decisions/ if present

          Produce one GitHub PR review:
            - approve if clean
            - comment or request changes for specific, actionable concerns
            - soft-warn if the Test Envelope is incomplete on a low-risk change
            - request changes when new behavior lacks tests, risk is unclear, or conventions/ADRs are violated

          If security-sensitive concerns, suspected secret leakage, or irreversible change risks appear:
            - add label user-review-needed
            - do not approve

          Also create or update a check named code-reviewer-ai with success or failure.
          If gh is unavailable, use ./.github/scripts/github-api.js pr-review and
          ./.github/scripts/github-api.js check-run with head SHA ${{ github.event.pull_request.head.sha }}.
          PROMPT
          ./.github/scripts/ai-run.sh --runner code-reviewer --role code-reviewer --prompt-file "$RUNNER_TEMP/code-reviewer-prompt.txt"
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Record successful review budget
        if: success() && steps.trust.outputs.should_review == 'true'
        run: ./.github/scripts/budget-record.sh --pr "${{ github.event.pull_request.number }}" --workflow code-reviewer --runner code-reviewer --result success --started-at "${{ steps.run_context.outputs.started_at }}"
        env:
          GITHUB_ACTOR: ${{ github.actor }}

      - name: Failure handling
        if: failure() && steps.trust.outputs.should_review == 'true'
        run: |
          node ./.github/scripts/github-api.js comment --pr "${{ github.event.pull_request.number }}" --body "Code Reviewer workflow failed; see Actions logs."
          node ./.github/scripts/github-api.js label-edit --pr "${{ github.event.pull_request.number }}" --add-label "blocked"
          ./.github/scripts/budget-record.sh --pr "${{ github.event.pull_request.number }}" --workflow code-reviewer --runner code-reviewer --result failure --started-at "${{ steps.run_context.outputs.started_at }}" || true
        env:
          GH_TOKEN: ${{ github.token }}
          GITHUB_ACTOR: ${{ github.actor }}
